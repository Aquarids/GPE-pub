# LLM configuration used by exp/run_gpe_evaluation.py.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-api-key
LLM_API_TYPE=chat_completions
LLM_TOOL_CHOICE=auto
LLM_TOOL_CALL_ATTEMPTS=3
LLM_DISABLE_THINKING=false

# Wikipedia search configuration. Access token is optional for public pages.
WIKI_ACCESS_TOKEN=
WIKI_LANGUAGE=en
WIKI_USER_AGENT=GeoPoisonEval/0.1
